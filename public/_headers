/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; connect-src 'self' https://login.microsoftonline.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# بوابة الحضور (تطبيق PWA): تحتاج الكاميرا والاتصال بخدمة Google (المسار المزدوج أثناء التجربة).
# «!» يفصل الترويسة الموروثة من القاعدة العامة أعلاه ثم نضع بدلها سياسة هذه الصفحة.
/gate/*
  ! Content-Security-Policy
  ! Permissions-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://script.google.com https://script.googleusercontent.com; media-src 'self' blob:; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
  Permissions-Policy: camera=(self), microphone=(), geolocation=()

# ملف الـ Service Worker لا يُخزَّن أبداً كي يصل أي تحديث فوراً.
/gate/sw.js
  Cache-Control: no-cache

# ملف الـ Service Worker الرئيسي لا يُخزَّن أبداً كي يصل أي تحديث فوراً.
/sw.js
  Cache-Control: no-cache

# الخطوط لا تتغير: تخزين لشهر.
/fonts/*
  Cache-Control: public, max-age=2592000
/gate/fonts/*
  Cache-Control: public, max-age=2592000
